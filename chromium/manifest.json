{
  "manifest_version": 3,
  "name": "Muter",
  "version": "1.2.0",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "permissions": ["scripting", "tabs", "storage", "sidePanel"],
  "host_permissions": [
    "*://class.nims.com.np/*",
    "*://api.groq.com/*"
  ],
  "action": {
    "default_title": "Muter",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "side_panel": {
    "default_title": "Muter",
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://class.nims.com.np/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://class.nims.com.np/*"],
      "js": ["extractor.js", "formatter.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
