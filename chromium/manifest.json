{
  "manifest_version": 3,
  "name": "Muter",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "permissions": ["scripting"],
  "host_permissions": ["*://class.nims.com.np/*"],
  "action": { "default_popup": "popup.html", "default_title": "Muter" },
  "icons": { "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": ["*://class.nims.com.np/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}